# ============================================================
# Predicta - variaveis de ambiente (exemplo)
# Copie para .env e ajuste os valores conforme o ambiente.
# ============================================================

# --- Geral ---
PROJECT_NAME=Predicta
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- PostgreSQL (catalogo: ativos, usuarios, auditoria) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=forzy
POSTGRES_PASSWORD=forzy_dev_password
POSTGRES_DB=forzy_catalog

# --- TimescaleDB (series temporais de telemetria) ---
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=forzy
TIMESCALE_PASSWORD=forzy_dev_password
TIMESCALE_DB=forzy_timeseries

# --- Redis (cache / pub-sub) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MQTT (broker Mosquitto) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- OPC-UA (simulador do motor) ---
OPCUA_ENDPOINT=opc.tcp://opcua-simulator:4840/forzy/server/
OPCUA_NAMESPACE_URI=http://forzy.promon/opcua/
OPCUA_PUBLISHING_INTERVAL_MS=1000

# --- ChromaDB (vector store para RAG) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- Seguranca ---
JWT_SECRET_KEY=dev-only-secret-change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- LLM (chat de troubleshooting com RAG) ---
# Sem ANTHROPIC_API_KEY o chat opera em modo offline (resposta extrativa).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- RAG (recuperacao aumentada para o chat) ---
RAG_VECTOR_BACKEND=memory
RAG_DOCUMENTS_DIR=/rag/documents
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# --- RBAC (controle de acesso baseado em papeis) ---
RBAC_ENABLED=true

# --- Sensores fisicos Forzy (API HTTP externa) ---
# URL do tunel divulgado pela Forzy (efemera - atualize quando mudar).
# Vazio = ingestao externa desabilitada. Dados atualizam seg/ter/qua 12h-14h.
EXTERNAL_SENSORS_BASE_URL=https://reseller-prescribed-facing-dept.trycloudflare.com
EXTERNAL_SENSORS_MAP=MTR-F01:/get_s1,MTR-F02:/get_s2
EXTERNAL_SENSORS_POLL_SECONDS=30
MONITORED_ASSET_TAGS=MTR-001,MTR-F01,MTR-F02

# --- Feature flags (modularidade - liga/desliga modulos) ---
FEATURE_AUTH=true
FEATURE_ASSETS=true
FEATURE_TELEMETRY=true
FEATURE_VISION=true
FEATURE_ML=true
FEATURE_ALERTS=true
FEATURE_RAG=true
FEATURE_AUTOMATION=true
FEATURE_GOVERNANCE=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_PREFIX=/api/v1
