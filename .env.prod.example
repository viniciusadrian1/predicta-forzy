# ============================================================
# Predicta - PRODUCAO (docker-compose.prod.yml)
# Copie para .env e preencha. Suba com:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# O compose ja injeta os hosts internos (postgres/timescaledb/redis/chromadb/
# opcua-simulator), ENVIRONMENT=production e RAG_VECTOR_BACKEND=chroma.
# Aqui vao so os SEGREDOS e as URLs publicas.
# ============================================================

# ----- OBRIGATORIO -----------------------------------------

# Senhas dos bancos (troque por valores fortes - o compose recusa subir sem elas).
POSTGRES_PASSWORD=troque-esta-senha-forte
TIMESCALE_PASSWORD=troque-esta-outra-senha-forte

# Chave de assinatura do JWT. Em production o backend NAO sobe com o default
# nem com menos de 32 caracteres (senao qualquer um forja um token admin).
# Gere com:  openssl rand -hex 32
JWT_SECRET_KEY=cole-aqui-o-resultado-de-openssl-rand-hex-32

# URLs publicas (troque IP_PUBLICO pelo IP da VM Oracle, ou um dominio).
#   CORS_ORIGINS  -> de onde o frontend chama a API (origem do browser).
#   PUBLIC_API_URL-> URL do backend "assada" no build do Next (frontend -> API).
# Frontend na porta 80, backend na 8000:
CORS_ORIGINS=http://IP_PUBLICO
PUBLIC_API_URL=http://IP_PUBLICO:8000

# ----- OPCIONAL --------------------------------------------

# Volt/RAG com IA (Claude). Vazio = chat em modo offline (resposta extrativa).
ANTHROPIC_API_KEY=

# Dados AO VIVO dos motores fisicos F01/F02 (tunel HTTP da Forzy, efemero).
# Vazio = F01/F02 usam so o historico importado (dado real, porem antigo).
EXTERNAL_SENSORS_BASE_URL=
EXTERNAL_SENSORS_MAP=MTR-F01:/get_s1,MTR-F02:/get_s2
EXTERNAL_SENSORS_POLL_SECONDS=30

# Simulador embutido: gera telemetria recente dos 3 motores (MTR-001 fisico +
# replay real de F01/F02) SEM depender do OPC-UA/tunel. Deixe "false" no stack
# completo (o simulador OPC-UA ja alimenta o MTR-001). Use "true" so se quiser
# uma demo auto-contida e tirar o servico opcua-simulator do compose.
DEMO_SIMULATOR=false

# Bancos (defaults ok - so mude se quiser).
POSTGRES_USER=forzy
POSTGRES_DB=forzy_catalog
TIMESCALE_USER=forzy
TIMESCALE_DB=forzy_timeseries

# Ativos avaliados pelo verificador de alertas.
MONITORED_ASSET_TAGS=MTR-001,MTR-F01,MTR-F02
